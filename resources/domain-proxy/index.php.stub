<?php
/**
 * KSM domain proxy - scritto da KSM al collegamento del dominio, non modificare a mano.
 * Inoltra ogni richiesta del dominio collegato all'app KSM (ksm.it),
 * passando il dominio originale in X-Forwarded-Host.
 */

const KSM_TARGET = '{{TARGET}}';

$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
$uri    = $_SERVER['REQUEST_URI'] ?? '/';
$isHttps = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')
    || (($_SERVER['SERVER_PORT'] ?? '') == 443);

// --- Header in uscita ---------------------------------------------------
$skip = ['host', 'connection', 'content-length', 'accept-encoding', 'expect',
         'x-forwarded-host', 'x-forwarded-proto', 'x-forwarded-port', 'x-forwarded-for'];
$contentType = $_SERVER['CONTENT_TYPE'] ?? '';
$isMultipart = stripos($contentType, 'multipart/form-data') === 0;
if ($isMultipart) {
    $skip[] = 'content-type'; // cURL rigenera il boundary
}

$headers = [];
foreach (getallheaders() as $name => $value) {
    if (in_array(strtolower($name), $skip, true)) {
        continue;
    }
    $headers[] = "$name: $value";
}
$headers[] = 'X-Forwarded-Host: ' . ($_SERVER['HTTP_HOST'] ?? '');
$headers[] = 'X-Forwarded-Proto: ' . ($isHttps ? 'https' : 'http');
$headers[] = 'X-Forwarded-Port: ' . ($isHttps ? '443' : '80');
$headers[] = 'X-Forwarded-For: ' . ($_SERVER['REMOTE_ADDR'] ?? '');

// --- Corpo della richiesta ------------------------------------------------
function ksm_flatten(array $data, string $prefix = ''): array
{
    $out = [];
    foreach ($data as $k => $v) {
        $key = $prefix === '' ? (string) $k : $prefix . '[' . $k . ']';
        if (is_array($v)) {
            $out += ksm_flatten($v, $key);
        } else {
            $out[$key] = $v;
        }
    }
    return $out;
}

function ksm_files(array $files): array
{
    $out = [];
    foreach ($files as $field => $f) {
        if (is_array($f['name'])) {
            $walk = function ($names, $tmp, $types, $errors, $key) use (&$walk, &$out) {
                foreach ($names as $i => $n) {
                    $k = $key . '[' . $i . ']';
                    if (is_array($n)) {
                        $walk($n, $tmp[$i], $types[$i], $errors[$i], $k);
                    } elseif ($errors[$i] === UPLOAD_ERR_OK) {
                        $out[$k] = new CURLFile($tmp[$i], $types[$i], $n);
                    }
                }
            };
            $walk($f['name'], $f['tmp_name'], $f['type'], $f['error'], $field);
        } elseif ($f['error'] === UPLOAD_ERR_OK) {
            $out[$field] = new CURLFile($f['tmp_name'], $f['type'], $f['name']);
        }
    }
    return $out;
}

$ch = curl_init(KSM_TARGET . $uri);
curl_setopt_array($ch, [
    CURLOPT_CUSTOMREQUEST  => $method,
    CURLOPT_HTTPHEADER     => $headers,
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HEADER         => true,
    CURLOPT_FOLLOWLOCATION => false,
    CURLOPT_ENCODING       => '',
    CURLOPT_CONNECTTIMEOUT => 10,
    CURLOPT_TIMEOUT        => 120,
]);

if ($method === 'HEAD') {
    curl_setopt($ch, CURLOPT_NOBODY, true);
} elseif (!in_array($method, ['GET', 'OPTIONS'], true)) {
    if ($isMultipart) {
        curl_setopt($ch, CURLOPT_POSTFIELDS, ksm_flatten($_POST) + ksm_files($_FILES));
    } else {
        curl_setopt($ch, CURLOPT_POSTFIELDS, file_get_contents('php://input'));
    }
}

$response = curl_exec($ch);
if ($response === false) {
    http_response_code(502);
    header('Content-Type: text/plain; charset=utf-8');
    echo 'Servizio temporaneamente non disponibile.';
    error_log('KSM proxy: ' . curl_error($ch));
    exit;
}

$status     = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
$headerSize = curl_getinfo($ch, CURLINFO_HEADER_SIZE);
curl_close($ch);

$rawHeaders = substr($response, 0, $headerSize);
$body       = substr($response, $headerSize);

// --- Risposta ---------------------------------------------------------------
http_response_code($status);
$blocks = preg_split("/\r\n\r\n/", trim($rawHeaders));
$last   = end($blocks); // ignora eventuali "100 Continue"
$drop   = ['transfer-encoding', 'content-encoding', 'content-length', 'connection', 'keep-alive'];
foreach (explode("\r\n", $last) as $i => $line) {
    if ($i === 0 || strpos($line, ':') === false) {
        continue;
    }
    [$name] = explode(':', $line, 2);
    if (in_array(strtolower(trim($name)), $drop, true)) {
        continue;
    }
    header($line, false);
}

echo $body;
